{
  "id": "playback-history",
  "name": "历史播放记录",
  "version": "0.5.0",
  "protocol": 1,
  "description": "NovaEmby 播放看板，手机优先并兼容大屏：统一展示播放概况、观看趋势、未结束会话、用户排行、热门内容和内容分布。支持 7/30/90 天、按用户查看、全屏展示及独立播放明细查询。开启系统播放开始/停止通知后采集历史。",
  "author": "NovaEmby 社区",
  "homepage": "/history",
  "entry": {
    "linux/amd64": "bin/playback-history-linux-amd64",
    "linux/arm64": "bin/playback-history-linux-arm64"
  },
  "events": [
    "playback.started",
    "playback.paused",
    "playback.stopped",
    "user.created",
    "user.updated",
    "user.deleted"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/history",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/app.js",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/styles.css",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/users",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/records",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/items",
      "auth": "none"
    },
    {
      "method": "DELETE",
      "path": "/history/records/{id}",
      "auth": "none"
    },
    {
      "method": "POST",
      "path": "/history/clear",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/dashboard",
      "auth": "none"
    },
    {
      "method": "GET",
      "path": "/history/theme.js",
      "auth": "none"
    }
  ],
  "config": [
    {
      "key": "recordMovies",
      "type": "bool",
      "label": "记录电影",
      "description": "记录电影的开始、暂停和停止播放事件。",
      "default": true
    },
    {
      "key": "recordEpisodes",
      "type": "bool",
      "label": "记录剧集",
      "description": "记录电视剧单集，并显示剧名、季号和集号。",
      "default": true
    },
    {
      "key": "recordOther",
      "type": "bool",
      "label": "记录其他视频",
      "description": "记录电影和剧集之外的视频类型，例如音乐视频或私人录像。",
      "default": false
    },
    {
      "key": "retentionDays",
      "type": "int",
      "label": "历史保留天数",
      "description": "每天自动清理早于该天数的播放记录；0 表示不按时间清理。",
      "default": 365,
      "min": 0,
      "max": 3650
    },
    {
      "key": "maxRecords",
      "type": "int",
      "label": "最多保留记录数",
      "description": "超出后优先删除最早的记录，避免数据文件无限增长。",
      "default": 50000,
      "min": 1000,
      "max": 500000
    },
    {
      "key": "completionPercent",
      "type": "int",
      "label": "看完判定进度",
      "description": "停止播放时，达到该播放进度百分比就标记为已看完。",
      "default": 90,
      "min": 50,
      "max": 100
    },
    {
      "key": "verboseEventLog",
      "type": "bool",
      "label": "完整事件诊断日志",
      "description": "排查播放事件时开启逐条日志和原始 JSON 分片；默认关闭，日常仅记录开始/停止播放、插件启停和异常。",
      "default": false
    }
  ],
  "memoryLimitMb": 128,
  "tasks": [
    {
      "key": "Cleanup",
      "name": "清理过期播放记录",
      "description": "按照插件配置删除过期或超出数量上限的记录，并压缩数据文件。",
      "defaultEnabled": true,
      "defaultTriggers": [
        {
          "type": "daily",
          "time": "04:20"
        }
      ]
    }
  ]
}
